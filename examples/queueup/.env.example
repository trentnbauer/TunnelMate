# Copy this file to .env in this directory (examples/queueup/).
# docker compose loads .env automatically -- no extra flag needed.
# Never commit your real .env (it's already in .gitignore).

# Image tags
TMVer=latest
QueueUpVer=latest

# Cloudflare account settings
CLOUDFLARE_API_TOKEN=changeme
CLOUDFLARE_ACCOUNT_ID=changeme
NAME=QueueUp

HOSTNAME_1=queueup.example.com
SERVICE_1=http://app:3000
USERS_1=

# QueueUp app settings
APP_BASE_URL=https://queueup.example.com
SESSION_SECRET=changeme-to-a-long-random-string
ADMIN_EMAILS=you@example.com
POSTGRES_PASSWORD=changeme
