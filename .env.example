# Cloudflare account settings
CLOUDFLARE_API_TOKEN=changeme
CLOUDFLARE_ACCOUNT_ID=changeme
TUNNEL_NAME=filmcalc-homelab

# Hostname 1: fully public, no Cloudflare Access
TUNNEL_HOSTNAME_1=whoami.example.com
TUNNEL_SERVICE_1=http://whoami:80
TUNNEL_ACCESS_1=public

# Hostname 2: protected by Cloudflare Access, only these emails can log in
TUNNEL_HOSTNAME_2=admin.example.com
TUNNEL_SERVICE_2=http://whoami:80
TUNNEL_ACCESS_2=auth
TUNNEL_AUTH_USERS_2=you@example.com,teammate@example.com

# Add more hostnames by continuing the sequence with no gaps:
# TUNNEL_HOSTNAME_3=..., TUNNEL_SERVICE_3=..., TUNNEL_ACCESS_3=bypass
