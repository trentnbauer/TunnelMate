# Cloudflare account settings
CLOUDFLARE_API_TOKEN=changeme
CLOUDFLARE_ACCOUNT_ID=changeme
NAME=Tunnel #Recommend naming the same as the app / purpose

# Hostname 1: fully public, no Cloudflare Access
HOSTNAME_1=whoami.example.com
SERVICE_1=http://whoami:80
ACCESS_1=public

# Hostname 2: protected by Cloudflare Access, only these emails can log in
HOSTNAME_2=admin.example.com
SERVICE_2=http://whoami:80
ACCESS_2=auth
AUTH_USERS_2=you@example.com,teammate@example.com

# Add more hostnames by continuing the sequence with no gaps:
# HOSTNAME_3=..., SERVICE_3=..., ACCESS_3=bypass
