# Copy this file to .env in the same directory as docker-compose.yml.
# docker compose loads .env automatically -- no extra flag needed.
# Never commit your real .env (it's already in .gitignore).

# TunnelMate image tag: `latest`, a floating major/minor (e.g. v0, v0.1),
# or a pinned release (e.g. v0.1.0). See README "Versioning / Releases".
TMVer=latest

# Cloudflare account settings
CLOUDFLARE_API_TOKEN=changeme
CLOUDFLARE_ACCOUNT_ID=changeme
NAME=Tunnel

# Hostname 1: fully public, no Cloudflare Access
HOSTNAME_1=whoami.example.com
SERVICE_1=http://whoami:80

# Hostname 2: path-scoped Access on HOSTNAME_1's /admin
HOSTNAME_2=whoami.example.com/admin
USERS_2=you@example.com,teammate@example.com
